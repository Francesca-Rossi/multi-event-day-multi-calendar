# Client ID OAuth2 di Google
# Ottenuto da Google Cloud Console (API e servizi -> Credenziali -> ID client OAuth 2.0)
# Il prefisso NUXT_PUBLIC_ rende la variabile accessibile lato client.
# NON inserire mai il Client Secret: questa app usa il flusso GSI/PKCE (client pubblico) e non ne ha bisogno.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-abcdefgh.apps.googleusercontent.com
